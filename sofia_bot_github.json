      "id": "chat-model",
      "name": "LLM de Sua Preferência",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1056,
        240
      ],
      "notes": "Escolha aqui o modelo que preferir. Para trocar de provedor (OpenAI, Anthropic, Ollama...), apague este nó e conecte outro Chat Model ao Tutor. Use um modelo multimodal para que a Sofia entenda imagens.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "id": "simple-memory",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [
        1232,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "// O Telegram aceita até 4096 caracteres por mensagem; a margem cobre as tags HTML e os escapes\nconst LIMITE = 3500;\n\nconst escapar = (s) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\n\n// Divide por linhas. Se o corte cair dentro de um bloco ```, fecha o bloco nesta parte e reabre na próxima\nfunction dividir(texto) {\n  const partes = [];\n  let linhas = [];\n  let tamanho = 0;\n  let emCodigo = false;\n\n  const fecharParte = () => {\n    if (!linhas.length) return;\n    partes.push(linhas.join('\\n') + (emCodigo ? '\\n```' : ''));\n    linhas = emCodigo ? ['```'] : [];\n    tamanho = emCodigo ? 4 : 0;\n  };\n\n  for (const linhaOriginal of texto.split('\\n')) {\n    // Linhas maiores que o limite são cortadas à força\n    for (let i = 0; i < Math.max(linhaOriginal.length, 1); i += LIMITE) {\n      const linha = linhaOriginal.slice(i, i + LIMITE);\n      if (tamanho + linha.length + 1 > LIMITE) fecharParte();\n      linhas.push(linha);\n      tamanho += linha.length + 1;\n      if (linha.trimStart().startsWith('```')) emCodigo = !emCodigo;\n    }\n  }\n  fecharParte();\n\n  return partes.filter((p) => p.replace(/```/g, '').trim());\n}\n\n// Converte o Markdown básico que a LLM usa para o HTML do Telegram.\n// Em HTML só <, > e & precisam de escape, então asteriscos e underlines soltos não quebram o envio.\nfunction paraHtml(md) {\n  return md\n    .split(/(```[^\\n]*\\n[\\s\\S]*?```)/g)\n    .map((trecho, i) => {\n      if (i % 2 === 1) {\n        const codigo = trecho.replace(/^```[^\\n]*\\n/, '').replace(/\\n?```$/, '');\n        return `<pre>${escapar(codigo)}</pre>`;\n      }\n      return escapar(trecho)\n        .replace(/`([^`\\n]+)`/g, '<code>$1</code>')\n        .replace(/\\*\\*([^*\\n]+)\\*\\*/g, '<b>$1</b>')\n        .replace(/^#{1,6}\\s+(.+)$/gm, '<b>$1</b>');\n    })\n    .join('');\n}\n\nconst texto =\n  String($json.output || '').trim() ||\n  'Não consegui gerar uma resposta. Tente reformular a pergunta.';\nconst chatId = $('Telegram Trigger').first().json.message.chat.id;\n\nreturn dividir(texto).map((parte) => ({\n  json: { chat_id: chatId, html: paraHtml(parte), texto: parte },\n  pairedItem: 0,\n}));\n"
      },
      "id": "format-response",
      "name": "Formatar Resposta",
      "type": "n8n-nodes-base.code",
